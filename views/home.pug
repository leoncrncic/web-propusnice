doctype html
html(lang="hr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Digitalne propusnice
    style.
      body {
        font-family: Arial, sans-serif;
        background: #f5f5f5;
        max-width: 700px;
        margin: 50px auto;
        padding: 20px;
      }
      .card {
        background: white;
        padding: 25px;
        border-radius: 10px;
      }
      .stats {
        display: flex;
        gap: 20px;
      }
      .stat {
        background: #eee;
        padding: 15px;
        flex: 1;
        border-radius: 8px;
      }

  body
    .card
      h1 Digitalne propusnice
      p Sustav za izdavanje i provjeru propusnica

      .stats
        .stat
          h2= total
          p Ukupno propusnica

        .stat
          h2= active
          p Aktivnih propusnica

      if isAuthenticated
        h2 Korisnički račun
        p Prijavljeni ste kao: #{user.email || user.name || "Korisnik"}

        p
          a(href="/profile") Moj profil

        form(action="/logout", method="post")
          button(type="submit") Odjava
      else
        h2 Korisnički račun
        p Za upravljanje propusnicama potrebna je prijava.

        a(href="/login") Prijava

        

